# Temporal-Spatial Memory System Environment Configuration
# Copy this file to .env and update with your actual values

# API Keys (add your actual keys here)
OPENAI_API_KEY=your_openai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Embedding Configuration
EMBEDDING_SERVICE_TYPE=langchain
EMBEDDING_MODEL_PROVIDER=sentence_transformer
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=cache/embeddings
EMBEDDING_CACHE_SIZE=1000

# Coordinate System Configuration
USE_EMBEDDING_COORDS=true
BASE_RADIUS=0.9
EMBEDDING_R_SCALE=1.0
EMBEDDING_THETA_SCALE=3.14159

# Storage and Database
DEFAULT_STORAGE_PATH=output/atlas_storage
VECTOR_INDEX_TYPE=faiss
ENABLE_COORDINATE_CACHE=true

# Retrieval Configuration
DEFAULT_K=10
DEFAULT_MAX_RESULTS=10
DEFAULT_KEYWORD_WEIGHT=0.3
DEFAULT_TEMPORAL_DECAY=0.1
DEFAULT_DIRECTIONAL_STRENGTH=0.3
DEFAULT_DIVERSITY_LAMBDA=0.7

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_DEBUG_LOGGING=false

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENABLE_CORS=true

# Model Configuration
DEFAULT_LLM_MODEL=gpt-4o-mini
HYDE_MODEL=gpt-3.5-turbo
RERANK_MODEL=cohere

# Performance Configuration
FAISS_INDEX_TYPE=IndexFlatL2
ENABLE_GPU=false
BATCH_SIZE=32 